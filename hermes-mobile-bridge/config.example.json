{
  "listen_host": "127.0.0.1",
  "listen_port": 8787,
  "state_dir": "/path/to/home/.local/state/hermes-mobile-bridge",
  "event_limit": 10000,
  "run_event_limit": 2000,
  "event_days": 7,
  "upload_limit": 10485760,
  "artifact_limit": 52428800,
  "backends": {
    "default": {
      "url": "http://127.0.0.1:9119",
      "token_file": "/path/to/home/.config/hermes-mobile-bridge/dashboard-token",
      "source_dir": "/path/to/home/.hermes/hermes-agent",
      "boards": ["default"],
      "workspaces": {"project": "/path/to/home/Projects/project"},
      "artifact_roots": ["/path/to/home/Projects/project/.hermes/desktop-attachments", "/path/to/home/.hermes/images", "/path/to/home/.hermes/screenshots"]
    }
  }
}
