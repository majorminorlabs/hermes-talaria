@@ -0,0 +1,32 @@
+"""Hermes knowledge-search compatibility route for PostgreSQL mode."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, HTTPException, Request, status
+
+from ...services.hermes_knowledge import serialize_hermes_knowledge
+from ..schemas import HermesKnowledgeResponse, HermesKnowledgeSearch
+from .hermes import require_hermes
+
+router = APIRouter(prefix="/hermes", tags=["hermes"])
+
+
+@router.post(
+    "/knowledge/search",
+    response_model=HermesKnowledgeResponse,
+    dependencies=[Depends(require_hermes)],
+)
+def search_knowledge_postgres(
+    payload: HermesKnowledgeSearch,
+    request: Request,
+) -> dict[str, object]:
+    """Search canonical archive records using the existing Hermes contract."""
+
+    runtime = getattr(request.app.state, "postgres_runtime", None)
+    if runtime is None:
+        raise HTTPException(
+            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
+            detail="PostgreSQL runtime is not enabled",
+        )
+    records = runtime.search_hermes_knowledge(payload.query, limit=payload.limit)
+    return serialize_hermes_knowledge(records)
diff --git a/apps/api/src/research_terminal/services/hermes_knowledge.py b/apps/api/src/research_terminal/services/hermes_knowledge.py
new file mode 100644
--- /dev/null
+++ b/apps/api/src/research_terminal/services/hermes_knowledge.py
@@ -0,0 +1,25 @@
+"""Shared response mapping for Hermes knowledge search adapters."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+from .retrieval import RetrievedRecord
+
+
+def serialize_hermes_knowledge(records: Iterable[RetrievedRecord]) -> dict[str, object]:
+    """Keep the Hermes search payload stable across SQLite and PostgreSQL."""
+
+    return {
+        "items": [
+            {
+                "record_type": item.record_type,
+                "record_id": item.record_id,
+                "title": item.title,
+                "excerpt": item.excerpt,
+                "score": item.score,
+                "source_ids": [source.id for source in item.source_refs],
+            }
+            for item in records
+        ]
+    }
diff --git a/docs/HERMES_POSTGRES_SEARCH.md b/docs/HERMES_POSTGRES_SEARCH.md
new file mode 100644
--- /dev/null
+++ b/docs/HERMES_POSTGRES_SEARCH.md
@@ -0,0 +1,56 @@
+# Hermes knowledge search in PostgreSQL mode
+
+Hermes uses the same authenticated endpoint and response shape with either
+Research Terminal persistence backend:
+
+```text
+POST /api/v1/hermes/knowledge/search
+Authorization: Bearer <Research Terminal Hermes token>
+{"query":"...","limit":8}
+```
+
+The `research-terminal` helper already calls this endpoint. Before the
+PostgreSQL compatibility route was added, `create_app()` registered the full
+ORM-backed Hermes router only for SQLite. PostgreSQL mode intentionally omitted
+those SQLite-only routes, so knowledge search returned 404 even though status
+and other PostgreSQL-native endpoints worked.
+
+PostgreSQL mode now registers a narrow authenticated compatibility route. It
+searches active, non-archived records in the configured canonical archive
+schema: sources and findings. PostgreSQL's `simple` full-text parser handles
+the shared Hermes query tokens with prefix matching. The adapter applies the
+same token selection and minimum-match checks as SQLite retrieval and returns
+the existing `record_type`, `record_id`, `title`, `excerpt`, `score`, and
+`source_ids` fields. Finding source IDs come from the canonical
+`finding_evidence` and `evidence.source_id` relationships. SQLite continues to
+use its existing FTS5 projection; no second API or alternate helper command is
+required.
+
+No database migration or corpus write is required. The API service must be
+restarted after deploying this code so it registers the compatibility route.
+The route does not create records or launch research jobs.
+
+## Validation
+
+The PostgreSQL integration regression uses the disposable database selected
+by `RESEARCH_TEST_POSTGRES_URL`; it creates a fixture source and checks the
+authenticated HTTP response and source mapping. The helper regression verifies
+that `search` still posts to the canonical endpoint. Run them with:
+
+```sh
+.venv/bin/python -m pytest apps/api/tests/test_postgres_pipeline.py -k hermes_knowledge
+.venv/bin/python -m pytest apps/api/tests/test_hermes_client.py -k search
+```
+
+After restarting a PostgreSQL-mode API, run a harmless existing-corpus lookup:
+
+```sh
+scripts/hermes-research-terminal search "<distinctive existing topic>" --limit 5
+```
+
+The helper reads its bearer token through
+`RESEARCH_TERMINAL_API_TOKEN_FILE`; never put the token value in shell history,
+arguments, logs, or this document. A 401 indicates token configuration or
+permissions; a 404 indicates the deployed API has not registered this route;
+an empty `items` array means the query did not match an active source or
+finding in the configured archive schema.
