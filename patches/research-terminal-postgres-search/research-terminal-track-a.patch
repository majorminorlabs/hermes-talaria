+def _hermes_excerpt(value: str, tokens: list[str], *, max_chars: int = 1_200) -> str:
+    """Return a bounded plain-text excerpt near the first matched query term."""
+
+    folded = value.casefold()
+    positions = [position for token in tokens if (position := folded.find(token)) >= 0]
+    start = max(0, min(positions, default=0) - 180)
+    end = min(len(value), start + max_chars)
+    excerpt = value[start:end].strip()
+    if start:
+        excerpt = "… " + excerpt
+    if end < len(value):
+        excerpt += " …"
+    return excerpt
@@ -289,0 +307,107 @@
+    def search_hermes_knowledge(
+        self, query: str, *, limit: int = 8
+    ) -> list[RetrievedRecord]:
+        """Search active PostgreSQL archive sources and findings for Hermes.
+
+        The SQLite and PostgreSQL adapters share the same token selection,
+        relevance gate, result type, and HTTP serialization. PostgreSQL uses
+        its native full-text parser over the canonical archive tables rather
+        than opening the SQLite projection in PostgreSQL mode.
+        """
+
+        tokens = _query_tokens(query)
+        if not tokens:
+            return []
+
+        # Tokens come from the shared word-only tokenizer, so each term is
+        # safe to quote as a tsquery lexeme. Prefix matching mirrors the
+        # SQLite FTS adapter's useful inflection behavior.
+        tsquery = " | ".join(f"'{token}':*" for token in tokens)
+        bounded_limit = min(max(limit, 1), 20)
+        candidate_limit = min(max(bounded_limit * 8, 48), 160)
+        schema = self.archive.schema
+        statement = text(
+            f"""WITH parsed_query AS (
+                       SELECT to_tsquery('simple', :tsquery) AS value
+                   ), candidates AS (
+                       SELECT 'source'::text AS record_type, s.id::text AS record_id,
+                              s.title,
+                              concat_ws(' ', s.title, s.canonical_uri, s.source_type,
+                                        s.authors::text, s.doi, s.provider, s.abstract) AS body,
+                              s.created_at,
+                              ARRAY[s.id::text] AS source_ids
+                       FROM {schema}.sources s
+                       WHERE s.status = 'active' AND s.archived_at IS NULL
+                       UNION ALL
+                       SELECT 'finding'::text AS record_type, f.id::text AS record_id,
+                              f.statement AS title,
+                              concat_ws(' ', f.statement, f.details, f.uncertainty) AS body,
+                              f.created_at,
+                              COALESCE(source_refs.source_ids, ARRAY[]::text[]) AS source_ids
+                       FROM {schema}.findings f
+                       LEFT JOIN LATERAL (
+                           SELECT array_agg(DISTINCT e.source_id::text
+                                            ORDER BY e.source_id::text) AS source_ids
+                           FROM {schema}.finding_evidence fe
+                           JOIN {schema}.evidence e ON e.id = fe.evidence_id
+                           WHERE fe.finding_id = f.id
+                             AND e.source_id IS NOT NULL
+                             AND e.archived_at IS NULL
+                       ) source_refs ON TRUE
+                       WHERE f.lifecycle_status = 'active' AND f.archived_at IS NULL
+                   )
+                   SELECT c.record_type, c.record_id, c.title, c.body, c.source_ids,
+                          ts_rank_cd(to_tsvector('simple', c.body), q.value) AS score
+                   FROM candidates c
+                   CROSS JOIN parsed_query q
+                   WHERE to_tsvector('simple', c.body) @@ q.value
+                   ORDER BY score DESC, c.created_at DESC, c.record_type, c.record_id
+                   LIMIT :candidate_limit"""
+        )
+        with self.engine.connect() as connection:
+            rows = (
+                connection.execute(
+                    statement,
+                    {"tsquery": tsquery, "candidate_limit": candidate_limit},
+                )
+                .mappings()
+                .all()
+            )
+
+        minimum_matches = 1 if len(tokens) == 1 else 2
+        results: list[RetrievedRecord] = []
+        for row in rows:
+            title = str(row["title"] or "")
+            body = str(row["body"] or "")
+            matched_terms = _matched_term_count(tokens, f"{title} {body}")
+            if matched_terms < minimum_matches:
+                continue
+            title_matches = _matched_term_count(tokens, title)
+            if len(tokens) > 2 and title_matches == 0 and matched_terms < 3:
+                continue
+
+            source_ids = row["source_ids"] or []
+            source_refs = tuple(
+                SourceReference(str(source_id), "", "", "source record")
+                for source_id in source_ids
+            )
+            score = float(row["score"] or 0.0)
+            results.append(
+                RetrievedRecord(
+                    record_type=str(row["record_type"]),  # type: ignore[arg-type]
+                    record_id=str(row["record_id"]),
+                    title=title,
+                    excerpt=_hermes_excerpt(body, tokens),
+                    body=body[:8_000],
+                    score=score,
+                    source_refs=source_refs,
+                    topic_ids=(),
+                    fts_score=score,
+                    matched_queries=(query.strip(),),
+                    term_coverage=matched_terms / len(tokens),
+                )
+            )
+            if len(results) >= bounded_limit:
+                break
+        return results
+
